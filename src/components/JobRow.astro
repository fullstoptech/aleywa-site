---
interface Props { n: number; title: string; line: string; gets: string[]; href: string }
const { n, title, line, gets, href } = Astro.props;
---
<article class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-6 py-8 border-t border-line" data-reveal>
  <div class="lg:col-span-1"><span class="text-h2 lg:text-h2 text-label lg:font-bold">{n}</span></div>
  <div class="lg:col-span-4 flex flex-col gap-3">
    <h3 class="text-h2">{title}</h3>
    <p class="text-body-lg">{line}</p>
  </div>
  <div class="lg:col-span-4 flex flex-col gap-2">
    <p class="text-label text-ink-muted">What you get</p>
    {gets.map((g) => <p class="text-body">{g}</p>)}
  </div>
  <div class="lg:col-span-3 flex items-start">
    <a href={href} class="text-body font-medium underline decoration-[1.5px] underline-offset-[4px] hover:text-[#7f1840] transition-colors duration-[120ms] min-h-[44px] inline-flex items-center">What it includes</a>
  </div>
</article>
