---
import Wordmark from './Wordmark.astro';
import { NAV, EMAIL, TAGLINE } from '../data/site';
interface Props { tone?: 'paper' | 'berry' }
const { tone = 'paper' } = Astro.props;
const berry = tone === 'berry';
---
<footer class={berry ? 'bg-berry' : 'bg-paper'} style={berry ? 'background:var(--color-berry);color:var(--color-paper);' : ''}>
  <div class="section-x">
    <div class="inner-x grid grid-cols-1 md:grid-cols-12 gap-8 py-16 pb-8" >
      <div class="md:col-span-4 flex flex-col gap-4">
        <a href="/" aria-label="Aleywa Studios — home"><Wordmark tone={berry ? 'berry' : 'paper'} /></a>
        <p class="text-body">{TAGLINE}</p>
      </div>
      <div class="md:col-span-2 flex flex-col gap-2">
        <p class="text-label" style={berry ? 'color:#fcd1da;' : 'color:var(--color-ink-muted);'}>Contact</p>
        <a href={`mailto:${EMAIL}`} class="text-body font-medium min-h-[44px] inline-flex items-center hover:underline underline-offset-[4px]">{EMAIL}</a>
        <a href="/" class="text-body font-medium min-h-[44px] inline-flex items-center hover:underline underline-offset-[4px]">aleywa.com</a>
      </div>
      <div class="md:col-span-3 flex flex-col gap-1">
        <p class="text-label" style={berry ? 'color:#fcd1da;' : 'color:var(--color-ink-muted);'}>Pages</p>
        {NAV.map((n) => <a href={n.href} class="text-body font-medium min-h-[44px] inline-flex items-center hover:underline underline-offset-[4px]">{n.label}</a>)}
      </div>
      <div class="md:col-span-3 flex flex-col gap-2">
        <p class="text-label" style={berry ? 'color:#fcd1da;' : 'color:var(--color-ink-muted);'}>About the site</p>
        <p class="text-caption" style={berry ? 'color:#fcd1da;' : ''}>Every mockup and render on this site is labelled. Names and details on mockups are samples.</p>
        <a href="/privacy" class="text-body font-medium min-h-[44px] inline-flex items-center hover:underline underline-offset-[4px]">Privacy</a>
      </div>
    </div>
  </div>
</footer>
