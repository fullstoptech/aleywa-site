---
interface Props { href?: string; variant?: 'primary' | 'secondary'; on?: 'paper' | 'berry'; size?: 'lg' | 'md'; class?: string; id?: string }
const { href, variant = 'primary', on = 'paper', size = 'lg', class: cls = '', id } = Astro.props;
const h = size === 'lg' ? 'h-14' : 'h-12';
let style = '';
if (variant === 'primary') style = on === 'berry' ? 'background:var(--color-paper);color:var(--color-ink);' : 'background:var(--color-ink);color:var(--color-paper);';
else style = on === 'berry' ? 'background:transparent;color:var(--color-paper);border:1px solid var(--color-paper);' : 'background:transparent;color:var(--color-ink);border:1px solid var(--color-ink);';
const Tag = href ? 'a' : 'button';
---
<Tag id={id} href={href} class={`inline-flex items-center justify-center px-6 text-body font-medium whitespace-nowrap transition-colors duration-[120ms] hover:opacity-90 active:opacity-80 ${h} ${cls}`} style={style}><slot /></Tag>
<style>
  a:hover, button:hover { transition-timing-function: cubic-bezier(0.2,0.7,0.2,1); }
</style>
