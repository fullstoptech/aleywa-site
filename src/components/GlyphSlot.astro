---
interface Props { glyph: string; status: string; size?: 'sm' | 'lg' }
const { glyph, status, size = 'sm' } = Astro.props;
---
<div class="flex flex-col gap-2 items-start">
  <span class={size === 'lg' ? 'text-display-fluid' : 'text-h2'} aria-hidden="true">{glyph}</span>
  <span class="text-caption text-ink-muted">{status}</span>
</div>
