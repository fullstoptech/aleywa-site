---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { steps } from '../data/steps';
---
<BaseLayout title="How we work — Aleywa Studios" description="The order we work in. You decide at each step." footerTone="berry">
  <PageHero size="h1" titleLines={['The order we work in,', 'and what you decide at each step']} />
  <section class="section-x"><div class="inner-x flex flex-col" data-reveal>
    {steps.map((s) => (
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 lg:gap-6 border-t border-line py-8">
        <div class="flex flex-col gap-1"><span class="text-label text-ink-muted">{s.n}</span><h2 class="text-h3">{s.title}</h2></div>
        <div class="flex flex-col gap-2"><p class="text-label text-ink-muted">We do</p><p class="text-body">{s.weDo}</p></div>
        <div class="flex flex-col gap-2"><p class="text-label text-ink-muted">You decide</p><p class="text-body">{s.youDecide}</p></div>
        <div class="flex flex-col gap-2"><p class="text-label text-ink-muted">You receive</p><p class="text-body">{s.youReceive}</p></div>
      </div>
    ))}
  </div></section>
  <section class="section-x"><div class="inner-x py-16 flex flex-col gap-3 max-w-[680px]">
    <p class="text-body">You decide at each step. We write down what we tried and what we gave up.</p>
    <p class="text-body">We label what is a mockup and what is not, and we tell you what is unfinished.</p>
  </div></section>
  <CtaBand tone="berry" size="h1" />
</BaseLayout>
