---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Stop from '../../components/Stop.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import { imageByName } from '../../data/images';
const jobs = (await getCollection('jobs')).sort((a, b) => a.data.n - b.data.n);
---
<BaseLayout title="What we do — Aleywa Studios" description="Brand identity and websites, made together, with the reason behind every decision written down." footerTone="berry">
  <PageHero size="display" titleLines={['Four jobs, in the', 'order we do them']} sub="Brand identity and websites, made together, with the reason behind every decision written down." />
  {jobs.map((j) => (
    <section class="section-x border-t border-line"><div class="inner-x grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 py-16 lg:py-24" data-reveal>
      <div class="lg:col-span-7 flex flex-col gap-5">
        <p class="text-h1-fluid">{j.data.n}</p>
        <h2 class="text-h1-fluid">{j.data.title}</h2>
        <p class="text-body-lg max-w-[680px]">{j.data.line}</p>
        <p class="text-label text-ink-muted">What you get</p>
        {j.data.gets.map((g) => <p class="text-body max-w-[680px]">{g}</p>)}
        <a href={`/what-we-do/${j.data.slug}`} class="text-body font-medium underline decoration-[1.5px] underline-offset-[4px] hover:text-[#7f1840] transition-colors duration-[120ms] min-h-[44px] inline-flex items-center">What it includes</a>
      </div>
      <article class="lg:col-span-5 flex flex-col gap-3">
        <div class="bg-hover-ground overflow-hidden"><Image src={imageByName[j.data.example.image]} alt={j.data.example.title} widths={[421, 842]} class="w-full aspect-[4/3] object-cover" /></div>
        <p class="text-caption text-ink-muted">{j.data.example.label}</p>
        <h3 class="text-h3">{j.data.example.title}</h3>
        <p class="text-body">{j.data.example.body}</p>
      </article>
    </div></section>
  ))}
  <section style="background:var(--color-hover-ground);"><div class="section-x"><div class="inner-x grid grid-cols-1 lg:grid-cols-12 gap-6 py-16 lg:py-24" data-reveal>
    <p class="text-label lg:col-span-4">Together</p>
    <div class="lg:col-span-8 flex flex-col gap-6">
      <h2 class="text-h2">One system, so your brand and your website are never designed apart<Stop size={9} /></h2>
      <p class="text-body-lg max-w-[680px]">You do not hire a logo maker and a web builder and join them up. One studio decides both, and the decisions are written down.</p>
    </div>
  </div></div></section>
  <CtaBand tone="berry" size="h1" />
</BaseLayout>
